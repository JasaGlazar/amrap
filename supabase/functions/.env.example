# Copy to supabase/functions/.env (gitignored); the local stack loads it on `supabase start`.
# PUSH_SECRET must equal the Vault secret amrap_push_secret (the dev seed sets local-push-secret).
PUSH_SECRET=local-push-secret
# Generate a key pair with: npx web-push@3.6.7 generate-vapid-keys
# The public key also goes into app/.env.local as VITE_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:trainer@amrap.local
