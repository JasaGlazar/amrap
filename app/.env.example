# Copy to .env.local for local development (`supabase start` prints these values).
# The anon key below is the public demo key of the local Supabase stack, safe to commit.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# Public VAPID key for web push (the public half of the pair in supabase/functions/.env).
# Leave empty to run without push; the app then shows notifications as unavailable.
VITE_VAPID_PUBLIC_KEY=
